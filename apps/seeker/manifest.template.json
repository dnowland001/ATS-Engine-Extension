{
  "manifest_version": 3,
  "name": "ATS Engine - Seekers",
  "short_name": "ATS Engine",
  "version": "0.3.2",
  "description": "Stop applying blindly. See a job? Check how well your CV matches it, see the gaps, and know what to do next - with ATS Engine.",
  "action": {
    "default_title": "ATS Engine - Seekers",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["__API_ORIGIN__/*"],
  "externally_connectable": { "matches": ["__APP_ORIGIN__/*"] },
  "minimum_chrome_version": "116",
  "key": ""
}
